    Private Sub SetupSLE(sle As DevExpress.XtraEditors.SearchLookUpEdit,
                         view As DevExpress.XtraGrid.Views.Grid.GridView,
                         name As String)
        sle.EnterMoveNextControl = True
        sle.Name = name
        sle.Properties.Appearance.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        sle.Properties.Appearance.Options.UseFont = True
        sle.Properties.TextPadding = New Padding(5, 0, 5, 0)
        sle.Properties.View = view
        sle.Properties.NullText = ""
        view.OptionsBehavior.Editable = False
        view.OptionsView.ShowGroupPanel = False
        view.OptionsView.ShowAutoFilterRow = True
    End Sub

    Private Sub SetupDateEdit(dte As DevExpress.XtraEditors.DateEdit, _readOnly As Boolean)
        dte.EnterMoveNextControl = True
        dte.Properties.Appearance.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        dte.Properties.Appearance.Options.UseFont = True
        dte.Properties.TextPadding = New Padding(5, 0, 5, 0)
        dte.Properties.DisplayFormat.FormatString = "MMMM dd, yyyy"
        dte.Properties.DisplayFormat.FormatType = DevExpress.Utils.FormatType.DateTime
        dte.Properties.EditFormat.FormatString = "MMMM dd, yyyy"
        dte.Properties.EditFormat.FormatType = DevExpress.Utils.FormatType.DateTime

        ' ✅ Dagdag — allow null
        dte.Properties.AllowNullInput = DevExpress.Utils.DefaultBoolean.True
        dte.EditValue = Nothing  ' ← default ay blank, hindi current date

        If _readOnly Then
            dte.Properties.ReadOnly = True
            dte.Properties.Buttons.Clear()
        End If
    End Sub

